# The local stack's settings, and what every value means.
#
# **Do not copy this to `.env` in the repository.** `.env` is gitignored *and*
# `cargo xtask check` fails if one appears at any depth: a real one holds the
# database password, and `NOCTUA.md §15.5` keeps secrets in ephemeral environment
# variables at the process boundary rather than in a file a clone could carry.
# The gate is absolute so that nobody has to remember which `.env` was the safe
# one.
#
# Two ways to use it, both of which leave the tree clean:
#
#   * Change nothing. Every variable `docker-compose.yml` reads is defaulted
#     there to the value below, so `cargo xtask dev` works out of the box.
#     `DATABASE_URL` is the one it does not read: `cargo xtask` derives it from
#     the others when it is unset, which is why the stack comes up without it.
#   * Keep a copy somewhere outside the repository and source it:
#         set -a; . ~/.config/noctua/central.env; set +a
#
# Every value here is a local-development default. None is a production
# credential and none ever should be: production configuration comes from the
# deployment, not from a file with `example` in its name.

POSTGRES_USER=noctua
POSTGRES_PASSWORD=noctua
POSTGRES_DB=noctua
POSTGRES_PORT=5432

# What the application connects with. Derived from the four above, and written
# out rather than assembled so that pointing the tools at a different database is
# one line.
DATABASE_URL=postgres://noctua:noctua@127.0.0.1:5432/noctua

# The central log store. `cargo xtask dev` prints the address of its interactive
# UI; it is http://127.0.0.1:9428/select/vmui/
LOGS_PORT=9428

# **The log endpoint is not here, and that is deliberate.** This file listed
# NC_LOG_ENDPOINT and nothing read it: the endpoint is an argument to
# `nc_log::Log::open`, with `ship.rs`'s DEFAULT_ENDPOINT as the value a caller
# gets by not passing one. A variable in this file that nothing reads is a
# setting a developer will change and then watch have no effect, in the file
# whose whole job is to say what the stack reads — so `no_unread_variable`
# fails the build on one.
